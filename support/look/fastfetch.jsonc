//   _____ _____ _____ _____ _____ _____ _____ _____ _____ 
//  |   __|  _  |   __|_   _|   __|   __|_   _|     |  |  |
//  |   __|     |__   | | | |   __|   __| | | |   --|     |
//  |__|  |__|__|_____| |_| |__|  |_____| |_| |_____|__|__|  HYPRLAND
//
//  by Bina


{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    	"source": "~/.local/share/fastfetch/images/hypr.png",
    	"type": "kitty",
    	"height": 18,
    	"padding": {
    		"top": 2
    	},
    	// the ascii fallback while hypr.png is missing
    	"color": {
    		"1": "32",
    		"2": "32"
    	}
    },
    "display": {
        "separator": " ",
        // color2 is the theme's primary in lucid's kitty palette, for every theme
        "color": {
            "keys": "32",
            "title": "32"
        }
    },
    "modules": [
	"break",
        "break",
        "break",
	{
            "type": "custom",
            "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m"
        },
	"break",
	{
            "type": "title",
            "keyWidth": 10
        },
        "break",
        {
            "type": "os",
            "key": " ",
            "keyColor": "32",  // = color2, the theme's primary
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "32",
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": " ",
            "keyColor": "32",  
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "32", 
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "32", 
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "32", 
        },
        {
            "type": "cursor",
            "key": " ",
            "keyColor": "32", 
        },
        {
            "type": "terminalfont",
            "key": " ",
            "keyColor": "32", 
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "32", 
        },
        {
            "type": "datetime",
            "format": "{1}-{3}-{11}",
            "key": " ",
            "keyColor": "32", 
        },
        
        {
            "type": "player",
            "key": " ",
            "keyColor": "32", 
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m"
        },
        "break",
        "break",
    ]
}
